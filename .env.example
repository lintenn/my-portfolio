# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` for local development (`cp .env.example .env.local`).
# In Vercel, set the same variables under Project → Settings → Environment Variables
# for both the "Production" and "Preview" environments.
# ──────────────────────────────────────────────────────────────────────────────

# ── AI chatbot (required for /api/chat) ───────────────────────────────────────
# Project-scoped key with restricted permissions. See docs/DEPLOYMENT.md#openai.
OPENAI_API_KEY=

# Optional. Any model id supported by the OpenAI Responses API.
# Default: gpt-6-luna (cheap, fast, 1M context). See docs/CHATBOT.md#model-choice.
# OPENAI_MODEL=gpt-6-luna

# ── Rate limiting (optional but recommended in production) ────────────────────
# Upstash Redis REST credentials. Without them, an in-memory limiter is used,
# which only protects a single serverless instance.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Contact form (required for /contact) ──────────────────────────────────────
# The form id from https://formspree.io (the part after /f/).
FORMSPREE_ENDPOINT=

# ── Site ──────────────────────────────────────────────────────────────────────
# Optional. Canonical URL used for SEO metadata, sitemap and Open Graph images.
# NEXT_PUBLIC_SITE_URL=https://www.luismigarcia.com
